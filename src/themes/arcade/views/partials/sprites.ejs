      [5, 5, 2, 2], [25, 5, 2, 2], [5, 25, 2, 2], [25, 25, 2, 2]
    ]
  };

  function arSunGrid() {
    const grid = [];
    const R = 13.2;

    for (let y = 0; y < AR_SIZE; y += 1) {
      grid[y] = [];
      for (let x = 0; x < AR_SIZE; x += 1) {
        const dx = x + 0.5 - AR_CX;
        const dy = y + 0.5 - AR_CY;
        const d = Math.hypot(dx, dy) / R;
        if (d > 1) { grid[y][x] = null; continue; }
        // Limb darkening: brightest at the centre, cooling toward the edge.
        let step = d < 0.30 ? 0 : d < 0.52 ? 1 : d < 0.72 ? 2 : d < 0.88 ? 3 : 4;
        grid[y][x] = AR_SUN.ramp[step];
      }
    }

    AR_SUN.grains.forEach(function (cell) {
      if (grid[cell[1]] && grid[cell[1]][cell[0]]) grid[cell[1]][cell[0]] = AR_SUN.ramp[1];
    });
    AR_SUN.spots.forEach(function (cell) {
      if (grid[cell[1]] && grid[cell[1]][cell[0]]) grid[cell[1]][cell[0]] = AR_SUN.ramp[5];
    });

    return grid;
  }
