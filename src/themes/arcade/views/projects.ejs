<%- include('./partials/head') %>

<section class="ar-section ar-section-first" id="projects">
  <div class="ar-shell">
    <div class="ar-page-head">
      <p class="ar-kicker">World 02</p>
      <h1 class="ar-page-title">Projects</h1>
      <p class="ar-page-lede">Things I have designed, built and shipped.</p>
    </div>

    <% if (projects.length) { %>
      <ul class="ar-grid">
        <% projects.forEach(function (project, index) { %>
          <%- include('./partials/project-card', { project: project, cardIndex: index }) %>
        <% }); %>
      </ul>
    <% } else { %>
      <p class="ar-empty">No projects published yet.<% if (user) { %> <a href="/admin/projects">Add one in the admin</a>.<% } %></p>
    <% } %>
  </div>
</section>

<%- include('./partials/foot') %>
