# Copy to .env and adjust. Nothing here is required for local development —
# `npm start` loads .env automatically if it exists.

# Long random string used to sign sessions and CSRF tokens. Set this in
# production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a secret is generated once and stored in the database.
SESSION_SECRET=

# Server
PORT=3000
HOST=127.0.0.1

# Uncomment for a production deployment. This also turns on Secure cookies,
# so only set it when the site is actually served over HTTPS — otherwise the
# browser will drop the session cookie and login will appear to do nothing.
# NODE_ENV=production

# Force Secure cookies independently of NODE_ENV.
# COOKIE_SECURE=true

# Set to true only when running behind a reverse proxy you control, so client
# IPs (used for login rate limiting) are read from X-Forwarded-For.
# TRUST_PROXY=true

# Optional storage locations (defaults: ./data and ./public/uploads)
# DATA_DIR=
# UPLOAD_DIR=
