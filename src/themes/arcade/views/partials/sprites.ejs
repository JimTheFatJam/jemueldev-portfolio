  /* The star. Its own thing: no terminator, a hot core falling off to a
     cooler limb, granulation, spots, and a corona that flickers. */
  const AR_SUN = {
    ramp: ['#ffffff', '#fff6b4', '#ffdc5a', '#ffb224', '#f08610', '#d35f08'],
    spots: [[11, 10], [12, 10], [11, 11], [19, 18], [20, 18], [20, 19], [14, 22]],
    grains: [[13, 7], [18, 8], [9, 13], [22, 14], [10, 19], [17, 12], [21, 21], [13, 17], [16, 25], [24, 11]],
