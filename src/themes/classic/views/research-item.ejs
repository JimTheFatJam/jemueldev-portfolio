<%- include('./partials/head') %>

<article class="detail">
  <div class="container container-narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/research">Research</a>
    </nav>

    <header class="detail-head">
      <h1><%= item.title %></h1>
      <p class="detail-meta">
        <% if (item.date) { %><span><%= item.date %></span><% } %>
        <% if (item.work_status) { %><span class="badge"><%= item.work_status %></span><% } %>
      </p>
      <% if (item.authors) { %><p class="detail-authors"><%= item.authors %></p><% } %>
      <% if (item.institution) { %><p class="detail-institution"><%= item.institution %></p><% } %>

      <ul class="detail-links">
        <% if (safeUrl(item.paper_url)) { %>
          <li><a class="button button-secondary button-small" href="<%= safeUrl(item.paper_url) %>" target="_blank" rel="noopener noreferrer">Read the paper</a></li>
        <% } %>
        <% if (safeUrl(item.github_url)) { %>
          <li><a class="button button-secondary button-small" href="<%= safeUrl(item.github_url) %>" target="_blank" rel="noopener noreferrer">View code</a></li>
        <% } %>
        <% (item.links || []).forEach(function (link) { if (safeUrl(link.url)) { %>
          <li><a class="button button-secondary button-small" href="<%= safeUrl(link.url) %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a></li>
        <% } }); %>
      </ul>
    </header>
  </div>

  <% if (item.thumbnail) { %>
    <div class="container">
      <div class="detail-hero-image">
        <%- include('shared/image', { media: item.thumbnail, imgSizes: '(max-width: 64rem) 100vw, 60rem', imgLoading: 'eager' }) %>
      </div>
    </div>
  <% } %>

  <div class="container container-narrow">
    <% if (item.abstract) { %>
      <section class="detail-abstract">
        <h2 class="detail-subtitle">Abstract</h2>
        <div class="prose"><%- md(item.abstract) %></div>
      </section>
    <% } %>

    <% if (item.keywords.length) { %>
      <section class=detail-keywords>
        <h2 class=detail-subtitle>Keywords</h2>
        <ul class=skill-list>
          <% item.keywords.forEach(function (keyword) { %><li class=skill-chip><%= keyword %></li><% }); %>
        </ul>
      </section>
    <% } %>

    <%- include('shared/blocks', { blocks: blocks }) %>

    <% if (item.gallery.length) { %>
      <section class="detail-gallery">
        <h2 class="detail-subtitle">Figures</h2>
        <ul class="gallery-grid" data-columns="2">
          <% item.gallery.forEach(function (image) { %>
            <li>
              <a class="gallery-item" href="<%= image.url %>" target="_blank" rel="noopener noreferrer">
                <%- include('shared/image', { media: image, imgSizes: '(max-width: 40rem) 100vw, 30rem', imgClass: 'gallery-img' }) %>
              </a>
            </li>
          <% }); %>
        </ul>
      </section>
    <% } %>

    <footer class="detail-foot">
      <a class="section-link" href="/research">← All research</a>
    </footer>
  </div>
</article>

<%- include('./partials/foot') %>
