<% Object.keys(AR_WORLDS).forEach(function (key) {
     const world = AR_WORLDS[key];
     const rings = arRings(world);
%><symbol id="ar-p-<%= key %>" viewBox="0 0 <%= AR_SIZE %> <%= AR_SIZE %>"><%- world.rings ? arRects(rings.back) : '' %><%- arRects(arSurface(world)) %><%- world.rings ? arRects(rings.front) : '' %><%- world.sparks ? arSparks(world.sparks.cells, world.sparks.variable, world.sparks.fallback) : '' %></symbol><% }); %>
<symbol id="ar-p-sun" viewBox="0 0 <%= AR_SIZE %> <%= AR_SIZE %>"><%- arRects(arSunGrid()) %><%- arSparks(AR_SUN.flares, '--ar-spark-corona', '#ffb224') %></symbol>
</defs></svg>
