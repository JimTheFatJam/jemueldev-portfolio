<%
  /* Pixel-art planet foundry.
   *
   * Every sprite is a 32x32 grid drawn into one shared viewBox, emitted once
   * as an SVG <symbol> and referenced with <use> wherever it is needed. One
   * copy of the art, however many planets are on the page.
   *
   * Each world is two things:
   *
   *   · a MATERIAL MAP — 32 rows of 32 characters naming what each pixel is
   *     made of ('.' is the base material). Drawn freehand; whatever falls
   *     outside the disc is simply masked away, so the maps can be sketched
   *     without counting to the edge.
   *
   *   · a set of RAMPS — five shades per material, lightest to darkest.
   *
   * The shading is computed rather than drawn. Each pixel inside the disc is
   * treated as a point on a sphere, lit from the upper left, and quantised to
   * one of the five steps; a thin rim light picks out the dark limb the way
   * hand-drawn pixel planets do. So a material map only says *what* is there
   * and the lighting says how round it looks — which is what keeps craters,
   * continents and cloud bands sitting on a sphere instead of on a disc.
   *
   * Runs of identical pixels merge into single rects, which takes a planet
   * from ~900 rects to ~150.
   */

  const AR_SIZE = 32;          // grid, and the viewBox
  const AR_CX = 15.5;          // disc centre
  const AR_CY = 15.5;
  const AR_R = 14;             // disc radius

  // Light from the upper left and slightly toward the viewer.
  const AR_LIGHT = (() => {
    const v = [-0.52, -0.58, 0.63];
    const len = Math.hypot(v[0], v[1], v[2]);
    return [v[0] / len, v[1] / len, v[2] / len];
  })();

  // Lambert term -> one of five steps. The bands are deliberately uneven:
  // more resolution near the terminator, where the eye reads the curve.
  function arShade(lambert) {
    if (lambert > 0.80) return 0;
    if (lambert > 0.54) return 1;
    if (lambert > 0.24) return 2;
    if (lambert > -0.04) return 3;
    return 4;
  }

  /* Build the lit grid for one world. Returns a 32x32 array of colours (or
     null where nothing is drawn). */
  function arSurface(world) {
    const map = world.map || [];
    const ramps = world.ramps;
    const grid = [];

    for (let y = 0; y < AR_SIZE; y += 1) {
      grid[y] = [];
      const row = map[y] || '';

      for (let x = 0; x < AR_SIZE; x += 1) {
        const nx = (x + 0.5 - AR_CX) / AR_R;
        const ny = (y + 0.5 - AR_CY) / AR_R;
        const d2 = nx * nx + ny * ny;

        if (d2 > 1) { grid[y][x] = null; continue; }

        const nz = Math.sqrt(1 - d2);
        const lambert = nx * AR_LIGHT[0] + ny * AR_LIGHT[1] + nz * AR_LIGHT[2];

        // The lit limb opposite the sun: a one-pixel atmosphere that stops a
        // planet reading as a flat coin.
        if (world.rim && d2 > 0.855 && lambert < 0.06) { grid[y][x] = world.rim; continue; }

        const key = row.charAt(x) || '.';
        const ramp = ramps[key] || ramps['.'];
        grid[y][x] = ramp[arShade(lambert)];
      }
    }

    return grid;
  }

  /* A ring system, as pixels. Sampled on the same grid so it matches the
     planet's resolution exactly, and split into the half behind the planet
     and the half in front of it so the planet sits *inside* the rings. */
  function arRings(world) {
    const spec = world.rings;
    const back = [];
    const front = [];
    if (!spec) return { back: back, front: front };

    const flatten = spec.flatten;   // vertical squash: how open the rings are
    const tilt = spec.tilt || 0;    // pixels the ring plane sits below centre

    for (let y = 0; y < AR_SIZE; y += 1) {
      back[y] = [];
      front[y] = [];

      for (let x = 0; x < AR_SIZE; x += 1) {
        const dx = x + 0.5 - AR_CX;
        const dy = (y + 0.5 - AR_CY - tilt) / flatten;
        const r = Math.hypot(dx, dy);

        let band = null;
        for (let i = 0; i < spec.bands.length; i += 1) {
          const b = spec.bands[i];
          if (r >= b.from && r < b.to) { band = b; break; }
        }
        if (!band) continue;

        // Shade across the ring: the far side is dimmer, and the arc passing
        // behind the planet is dimmer still.
        const behind = dy < 0;
        let step = band.shade + (behind ? 1 : 0);

        // The planet throws a shadow across the near rings.
        const inShadow = !behind && dx > -3 && dx < 11 && Math.abs(dy) < AR_R + 3;
        if (inShadow) step += 2;

        const colour = spec.ramp[Math.min(step, spec.ramp.length - 1)];

        // Anything over the disc belongs to the planet, not the rings.
        const onDisc = Math.hypot(x + 0.5 - AR_CX, y + 0.5 - AR_CY) <= AR_R;
        if (onDisc) continue;

        if (behind) back[y][x] = colour;
        else front[y][x] = colour;
      }
    }

    return { back: back, front: front };
  }

  /* Merge runs of equal colour along each row into single rects. */
  function arRects(grid, extraClass) {
    const out = [];
    const cls = extraClass ? ' class="' + extraClass + '"' : '';

    for (let y = 0; y < AR_SIZE; y += 1) {
      const row = grid[y] || [];
      let x = 0;
      while (x < AR_SIZE) {
        const colour = row[x];
        if (!colour) { x += 1; continue; }
        let run = 1;
        while (x + run < AR_SIZE && row[x + run] === colour) run += 1;
        out.push('<rect x="' + x + '" y="' + y + '" width="' + run + '" height="1" fill="' + colour + '"' + cls + '/>');
        x += run;
      }
    }

    return out.join('');
  }

  /* Pixels that blink. They take their colour from an inherited custom
     property, because CSS selectors cannot reach inside a <use>, but custom
     properties inherit straight through it. Animating an unregistered
     property switches it in hard steps, which is the blink we want anyway. */
  function arSparks(cells, variable, fallback) {
    return cells.map(function (cell) {
      return '<rect x="' + cell[0] + '" y="' + cell[1] + '" width="' + (cell[2] || 1) +
             '" height="' + (cell[3] || 1) + '" fill="var(' + variable + ', ' + fallback + ')"/>';
    }).join('');
  }

