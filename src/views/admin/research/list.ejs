<%- include('../partials/head') %>

<div class="page-title">
  <div>
    <h1>Research</h1>
    <p class="page-sub">Theses, papers and ongoing investigations.</p>
  </div>
  <a class="button button-primary" href="/admin/research/new">Add research</a>
</div>

<% if (items.length === 0) { %>
  <section class="panel">
    <p class="empty-state">Nothing here yet. <a href="/admin/research/new">Add your first research item</a>.</p>
  </section>
<% } else { %>
  <section class="panel panel-flush">
    <ul class="record-list">
      <% items.forEach(function (item, index) { %>
        <li class="record">
          <div class="record-order">
            <form method="post" action="/admin/research/<%= item.id %>/move" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="up">
              <button class="icon-button" type="submit" aria-label="Move <%= item.title %> up"<%= index === 0 ? ' disabled' : '' %>>↑</button>
            </form>
            <form method="post" action="/admin/research/<%= item.id %>/move" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="down">
              <button class="icon-button" type="submit" aria-label="Move <%= item.title %> down"<%= index === items.length - 1 ? ' disabled' : '' %>>↓</button>
            </form>
          </div>

          <div class="record-body record-body-wide">
            <a class="record-title" href="/admin/research/<%= item.id %>"><%= item.title %></a>
            <p class="record-sub"><%= item.authors || 'No authors listed' %></p>
            <p class="record-meta">
              <span class="tag <%= item.isPublished ? 'tag-live' : 'tag-draft' %>"><%= item.isPublished ? 'Published' : 'Draft' %></span>
              <% if (item.featured) { %><span class="tag tag-featured">Featured</span><% } %>
              <% if (item.work_status) { %><span class="tag"><%= item.work_status %></span><% } %>
              <% if (item.date) { %><span><%= item.date %></span><% } %>
            </p>
          </div>

          <div class="record-actions">
            <form method="post" action="/admin/research/<%= item.id %>/feature" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small" type="submit"><%= item.featured ? 'Unfeature' : 'Feature' %></button>
            </form>
            <form method="post" action="/admin/research/<%= item.id %>/status" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="status" value="<%= item.isPublished ? 'draft' : 'published' %>">
              <button class="button button-small" type="submit"><%= item.isPublished ? 'Unpublish' : 'Publish' %></button>
            </form>
            <a class="button button-small" href="/admin/research/<%= item.id %>">Edit</a>
            <form method="post" action="/admin/research/<%= item.id %>/delete" class="inline-form"
                  data-confirm="Delete “<%= item.title %>”? This cannot be undone.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small button-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>

<%- include('../partials/foot') %>
