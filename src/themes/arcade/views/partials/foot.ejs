</main>

<footer class="ar-footer">
  <div class="ar-shell ar-footer-inner">
    <div>
      <p class="ar-label"><span class="ar-label-num">—</span>Colophon</p>
      <p class="ar-footer-name"><%= settings.site.name %></p>
      <p class="ar-footer-meta">&copy; <%= new Date().getFullYear() %><% if (user) { %> · <a href="/admin">Admin</a><% } %></p>
      <%# CC BY 4.0 asks for the credit to travel with the work. %>
      <p class="ar-footer-credit">Planet textures by <a href="https://www.solarsystemscope.com/textures/" target="_blank" rel="noopener noreferrer">Solar System Scope</a> · <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a></p>
    </div>

    <div>
      <p class="ar-label"><span class="ar-label-num">—</span>Elsewhere</p>
      <ul class="ar-footer-links">
        <% settings.site.emails.forEach(function (address) { %>
          <li><a href="mailto:<%= address %>"><%= address %></a></li>
        <% }); %>
        <% if (safeUrl(settings.site.github)) { %>
          <li><a href="<%= safeUrl(settings.site.github) %>" target="_blank" rel="noopener noreferrer">GitHub</a></li>
        <% } %>
        <% if (safeUrl(settings.site.linkedin)) { %>
          <li><a href="<%= safeUrl(settings.site.linkedin) %>" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <% } %>
        <% if (safeUrl(settings.site.resumeUrl)) { %>
          <li><a href="<%= safeUrl(settings.site.resumeUrl) %>" target="_blank" rel="noopener noreferrer">Resume</a></li>
        <% } %>
        <% (settings.site.extraLinks || []).forEach(function (link) { if (safeUrl(link.url)) { %>
          <li><a href="<%= safeUrl(link.url) %>" target="_blank" rel="noopener noreferrer"><%= link.label %></a></li>
        <% } }); %>
      </ul>
    </div>
  </div>
</footer>

<script src="<%= themeAssets %>/theme.js" defer></script>
</body>
</html>
