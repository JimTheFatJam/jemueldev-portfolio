<%- include('../partials/head') %>

<div class="page-title">
  <div>
    <h1>Pages</h1>
    <p class="page-sub">Extra pages built from content blocks — a longer bio, notes, anything you add later.</p>
  </div>
  <a class="button button-primary" href="/admin/pages/new">Add page</a>
</div>

<% if (pages.length === 0) { %>
  <section class="panel">
    <p class="empty-state">No extra pages yet. The portfolio does not need any — add one when you do.</p>
  </section>
<% } else { %>
  <section class="panel panel-flush">
    <ul class="record-list">
      <% pages.forEach(function (page, index) { %>
        <li class="record">
          <div class="record-order">
            <form method="post" action="/admin/pages/<%= page.id %>/move" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="up">
              <button class="icon-button" type="submit" aria-label="Move <%= page.title %> up"<%= index === 0 ? ' disabled' : '' %>>↑</button>
            </form>
            <form method="post" action="/admin/pages/<%= page.id %>/move" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="direction" value="down">
              <button class="icon-button" type="submit" aria-label="Move <%= page.title %> down"<%= index === pages.length - 1 ? ' disabled' : '' %>>↓</button>
            </form>
          </div>

          <div class="record-body record-body-wide">
            <a class="record-title" href="/admin/pages/<%= page.id %>"><%= page.title %></a>
            <p class="record-meta">
              <span class="tag <%= page.status === 'published' ? 'tag-live' : 'tag-draft' %>"><%= page.status === 'published' ? 'Published' : 'Draft' %></span>
              <% if (page.showInNav) { %><span class="tag">In navigation</span><% } %>
              <span class="record-slug">/<%= page.slug %></span>
            </p>
          </div>

          <div class="record-actions">
            <a class="button button-small" href="/admin/pages/<%= page.id %>">Edit</a>
            <form method="post" action="/admin/pages/<%= page.id %>/delete" class="inline-form"
                  data-confirm="Delete “<%= page.title %>” and its blocks?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="button button-small button-danger" type="submit">Delete</button>
            </form>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>
<% } %>

<%- include('../partials/foot') %>
