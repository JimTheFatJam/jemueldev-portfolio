<%
  /* The one shape every world is cut from: a 16x16 pixel disc, centred in a
   * 24x24 box so there are four cells of margin for rings and aerials.
   * Row spans are [x, width], top to bottom. Included once per page; each
   * world sprite then clips to it, which is what keeps every edge on a cell
   * boundary and makes the art read as pixels rather than as a shrunk circle.
   */
  const AR_DISC = [
    [5, 6], [3, 10], [2, 12], [1, 14], [1, 14], [0, 16], [0, 16], [0, 16],
    [0, 16], [0, 16], [0, 16], [1, 14], [1, 14], [2, 12], [3, 10], [5, 6]
  ];
%><svg class="ar-defs" aria-hidden="true" focusable="false" width="0" height="0"><defs><clipPath id="ar-disc"><% AR_DISC.forEach(function (row, y) { %><rect x="<%= row[0] + 4 %>" y="<%= y + 4 %>" width="<%= row[1] %>" height="1"/><% }); %></clipPath></defs></svg>
