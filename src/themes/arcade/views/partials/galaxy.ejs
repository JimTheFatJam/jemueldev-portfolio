<%
  /* The star chart: the landing attraction and the primary navigation.
   *
   * Flat rather than perspective-projected. A face-on system squashed
   * vertically reads as a tilted plane, needs no depth sorting and no camera
   * matrix, and stays crisp as pixel art — so the whole orientation is three
   * numbers the stylesheet already understands.
   *
   * The transform chain, outermost first:
   *
   *   .ar-camera     scale(zoom) rotate(spin) scaleY(flat)   <- script writes
   *   .ar-arm        rotate(0 -> 360deg)                     <- CSS animation
   *   .ar-arm-fix    rotate(0 -> -360deg)                    <- CSS animation
   *   .ar-world      scaleY(1/flat) rotate(-spin)            <- script writes
   *
   * The two animations cancel, and the last line undoes everything the camera
   * did except the uniform zoom. So a planet stays perfectly round and
   * upright at any orientation, its hit area stays round with it, and the
   * script only ever writes custom properties on the camera — it never
   * touches the elements carrying the animations, which is why orienting the
   * system cannot make the orbits stutter or stop.
   *
   * Two ways into the same six destinations:
   *   · the orrery, for anyone with a pointer. It carries no text at all —
   *     hovering a world lights up its row in the dock instead — so a moving
   *     label can never collide with the art.
   *   · the dock, a labelled list that never moves. This is the accessible
   *     path, and on a small screen it is the whole interface.
   */
  const isHome = currentPath === '/';
  const anchor = (id) => (isHome ? '#' + id : '/#' + id);
  const titles = settings.sectionTitles;

  const worlds = [];
  if (settings.sections.about) {
    worlds.push({ world: 'terra', name: 'About', code: 'ABT', href: anchor('about'), blurb: 'Who I am' });
  }
  if (settings.sections.projects) {
    worlds.push({ world: 'forge', name: titles.projects || 'Projects', code: 'WRK', href: '/projects', blurb: 'Things I have built' });
  }
  if (settings.sections.skills) {
    worlds.push({ world: 'circuit', name: titles.skills || 'Skills', code: 'SKL', href: anchor('skills'), blurb: 'What I build with' });
  }
  if (settings.sections.research) {
    worlds.push({ world: 'cryo', name: titles.research || 'Research', code: 'RSH', href: '/research', blurb: 'Studies and papers' });
  }
  if (settings.sections.education && (education || []).length) {
    worlds.push({ world: 'halo', name: titles.education || 'Education', code: 'EDU', href: anchor('education'), blurb: 'Where I studied' });
  }
  if (settings.sections.contact) {
    worlds.push({ world: 'relay', name: titles.contact || 'Contact', code: 'CTC', href: anchor('contact'), blurb: 'Get in touch' });
  }

  // Six rings are styled; anything beyond would stack, so it is capped.
  const orbits = worlds.slice(0, 6);
  const siteName = settings.site.name || 'Portfolio';
  const techCount = new Set((projects || []).flatMap((p) => p.tech.map((t) => t.name))).size;
%>

<%- include('./sprites') %>

<section class="ar-map" aria-labelledby="ar-map-title">
  <div class="ar-shell ar-map-inner">
    <div class="ar-map-brief">
      <p class="ar-eyebrow"><span class="ar-blink" aria-hidden="true">■</span><%= hero.identity || settings.site.tagline || 'Portfolio' %></p>
      <h1 class="ar-title" id="ar-map-title"><%= hero.headline || siteName %></h1>

      <% if (hero.intro) { %>
        <div class="ar-lede"><p><%- mdInline(hero.intro) %></p></div>
      <% } %>

      <dl class="ar-stats">
        <% if (settings.sections.projects) { %>
          <div><dt>Projects</dt><dd><%= String((projects || []).length).padStart(2, '0') %></dd></div>
        <% } %>
        <% if (techCount) { %>
          <div><dt>Tools</dt><dd><%= String(techCount).padStart(2, '0') %></dd></div>
        <% } %>
        <div><dt>Worlds</dt><dd><%= String(orbits.length).padStart(2, '0') %></dd></div>
      </dl>

      <nav class="ar-dock" aria-label="Explore">
        <p class="ar-dock-head" id="ar-dock-head">
          <span class="ar-hint-key" aria-hidden="true">&#9654;</span>Select a world
        </p>
        <ul>
          <% orbits.forEach(function (item, index) { %>
            <li>
              <a class="ar-dock-link" href="<%= item.href %>" data-world="<%= index + 1 %>">
                <span class="ar-dock-sprite" aria-hidden="true"><%- include('./planet-sprite', { world: item.world, spriteClass: 'ar-sprite ar-sprite-chip' }) %></span>
                <span class="ar-dock-text">
                  <span class="ar-dock-code" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %> &middot; <%= item.code %></span>
                  <span class="ar-dock-name"><%= item.name %></span>
                  <span class="ar-dock-blurb" aria-hidden="true"><%= item.blurb %></span>
                </span>
                <span class="ar-dock-go" aria-hidden="true">&#9654;</span>
              </a>
            </li>
          <% }); %>
        </ul>
      </nav>
    </div>

    <%# The visual map. Hidden from assistive technology and out of the tab
        order, because the dock above already names every destination. %>
    <div class="ar-orrery" aria-hidden="true">
      <div class="ar-orrery-frame" data-scene>
        <div class="ar-camera">
          <span class="ar-star"><%- include('./planet-sprite', { world: 'sun', spriteClass: 'ar-sprite ar-sprite-sun' }) %></span>

          <% orbits.forEach(function (item, index) { %>
            <span class="ar-ring ar-ring--<%= index + 1 %>">
              <span class="ar-arm">
                <span class="ar-arm-fix">
                  <a class="ar-world" href="<%= item.href %>" tabindex="-1" data-world="<%= index + 1 %>">
                    <span class="ar-world-sprite"><%- include('./planet-sprite', { world: item.world, spriteClass: 'ar-sprite ar-sprite-world' }) %></span>
                  </a>
                </span>
              </span>
            </span>
          <% }); %>
        </div>

        <p class="ar-hud" data-hud>
          <span class="ar-hud-key">SCROLL</span> zoom
          <span class="ar-hud-sep">&middot;</span>
          <span class="ar-hud-key">DRAG</span> orbit
        </p>
        <p class="ar-hud ar-hud-zoom" data-zoom-readout aria-hidden="true">100%</p>
      </div>
    </div>

    <a class="ar-scroll" href="#ar-content">
      <span>Continue</span><span class="ar-scroll-arrow" aria-hidden="true">&#9660;</span>
    </a>
  </div>
</section>
