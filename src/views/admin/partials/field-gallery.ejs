<%
  // Locals: fieldName, fieldLabel, fieldItems (array of media objects), fieldHelp
  const _name = fieldName;
  const _items = (typeof fieldItems !== 'undefined' && fieldItems) || [];
  const _help = typeof fieldHelp !== 'undefined' ? fieldHelp : '';
%>
<div class="field">
  <span class="field-label"><%= fieldLabel %></span>
  <div class="gallery-field" data-gallery-field>
    <input type="hidden" name="<%= _name %>" value="<%= JSON.stringify(_items.map(function (i) { return i.id; })) %>" data-gallery-input>
    <ul class="gallery-field-list" data-gallery-list>
      <% _items.forEach(function (item) { %>
        <li data-media-id="<%= item.id %>">
          <img src="<%= item.url %>" alt="<%= item.alt || item.original_name %>">
          <span class="gallery-field-name"><%= item.original_name %></span>
          <span class="gallery-field-buttons">
            <button type="button" class="icon-button" data-gallery-move="up" aria-label="Move <%= item.original_name %> earlier">↑</button>
            <button type="button" class="icon-button" data-gallery-move="down" aria-label="Move <%= item.original_name %> later">↓</button>
            <button type="button" class="icon-button" data-gallery-remove aria-label="Remove <%= item.original_name %>">✕</button>
          </span>
        </li>
      <% }); %>
    </ul>
    <p class="gallery-field-empty" data-gallery-empty<%= _items.length ? ' hidden' : '' %>>No images added yet.</p>
    <button type="button" class="button button-small" data-gallery-add>Add images</button>
  </div>
  <% if (_help) { %><p class="field-help"><%= _help %></p><% } %>
</div>
